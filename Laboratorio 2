# Ejercicio 1.2 — Amortización simple

capex_usd = 1_000_000_000
wafers_per_month = 20000
months = 60

params = FabParams(300, 6000, 200, 0.0005)

# costo normal por die bueno
cost_without_amort = cost_per_good_die(params, packaging_test_usd=10)

# calcular costo efectivo del wafer incluyendo amortización
wafer_cost_effective = params.wafer_cost_usd + capex_usd / (wafers_per_month * months)

# crear nuevos parámetros con el costo actualizado
params_amort = FabParams(
    wafer_diameter_mm=params.wafer_diameter_mm,
    wafer_cost_usd=wafer_cost_effective,
    die_area_mm2=params.die_area_mm2,
    defect_density_per_mm2=params.defect_density_per_mm2,
    alpha=params.alpha
)

# costo con amortización
cost_with_amort = cost_per_good_die(params_amort, packaging_test_usd=10)

print("Costo sin amortización:", cost_without_amort)
print("Costo con amortización:", cost_with_amort)

