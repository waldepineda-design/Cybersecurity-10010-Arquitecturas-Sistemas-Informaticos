---------------Implementa add8(a,b) que retorne:--------------
sum8 (0..255)
carry_out (0/1)
overflow_signed (0/1) para suma en int8 (dos complementos)
#Codigo
a8 = to_uint8(a)
    b8 = to_uint8(b)

    s = a8 + b8

    sum8 = s & 0xFF
    carry_out = 1 if s > 0xFF else 0
    overflow_signed = overflow_add_int8(a8, b8, sum8)

    return Add8Result(sum8, carry_out, overflow_signed)

--------------Implementa sub8(a,b) para a - b que retorne:-------------------
diff8 (0..255)
borrow_out (0/1) unsigned
overflow_signed (0/1) para int8

a8 = to_uint8(a)
    b8 = to_uint8(b)

    d = a8 - b8

    diff8 = d & 0xFF
    borrow_out = 1 if a8 < b8 else 0
    overflow_signed = overflow_sub_int8(a8, b8, diff8)

    return Sub8Result(diff8, borrow_out, overflow_signed)

